<UserControl
    x:Class="System.Windows.Controls.WindowAutoCompleteTextBox"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    MinHeight="38"
    Loaded="Control_Loaded"
    SizeChanged="Control_SizeChanged"
    Unloaded="Control_Unloaded"
    mc:Ignorable="d">

    <UserControl.Resources>

        <!--  Löschen-Button  -->
        <Style x:Key="ClearButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="ButtonBorder"
                            Margin="3"
                            Background="Transparent"
                            CornerRadius="4">

                            <Path
                                x:Name="ClearIcon"
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Data="M 5,5 L 15,15 M 15,5 L 5,15"
                                Stretch="Fill"
                                Stroke="#606060"
                                StrokeEndLineCap="Round"
                                StrokeStartLineCap="Round"
                                StrokeThickness="1.8" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#E8E8E8" />
                                <Setter TargetName="ClearIcon" Property="Stroke" Value="#202020" />
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D8D8D8" />
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ClearIcon" Property="Opacity" Value="0.35" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Vorschlagseintrag mit Highlight  -->
        <DataTemplate x:Key="SuggestionTemplate">
            <TextBlock VerticalAlignment="Center" FontSize="13">
                <Run Text="{Binding Prefix}" />
                <Run
                    Background="{Binding HighlightBrush}"
                    FontWeight="SemiBold"
                    Foreground="{Binding HighlightForeground}"
                    Text="{Binding Match}" />
                <Run Text="{Binding Suffix}" />
            </TextBlock>
        </DataTemplate>

        <!--  Vorschlagszeile  -->
        <Style x:Key="SuggestionItemStyle" TargetType="ListBoxItem">

            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Margin" Value="3,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4">

                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#F0F0F0" />
                            </Trigger>

                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#E5E5E5" />
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid>

        <!--  Hauptbereich  -->
        <Border
            x:Name="MainBorder"
            Background="Transparent"
            BorderBrush="#D1D1D1"
            BorderThickness="1"
            CornerRadius="{Binding CornerRadius, ElementName=Root}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="42" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="36" />
                </Grid.ColumnDefinitions>

                <!--  LINKE SPALTE  -->
                <Border
                    Grid.Column="0"
                    Background="{Binding IconBackground, ElementName=Root}"
                    CornerRadius="4,0,0,4">

                    <Image
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Source="{Binding Icon, ElementName=Root}"
                        Stretch="Uniform" />
                </Border>

                <!--  MITTLERE SPALTE  -->
                <Border Grid.Column="1" Background="{Binding TextBackground, ElementName=Root}">

                    <Grid>

                        <TextBox
                            x:Name="PART_TextBox"
                            Padding="8,0"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{Binding TextForeground, ElementName=Root}"
                            FontSize="14"
                            Foreground="{Binding TextForeground, ElementName=Root}"
                            GotKeyboardFocus="PART_TextBox_GotFocus"
                            IsReadOnly="{Binding IsReadOnly, ElementName=Root}"
                            LostKeyboardFocus="PART_TextBox_LostFocus"
                            MaxLength="{Binding MaxLength, ElementName=Root}"
                            PreviewKeyDown="PART_TextBox_PreviewKeyDown"
                            Text="{Binding Text, ElementName=Root, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PART_TextBox_TextChanged" />

                        <!--  Placeholder  -->
                        <TextBlock
                            x:Name="PlaceholderText"
                            Margin="9,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Foreground="{Binding PlaceholderForeground, ElementName=Root}"
                            IsHitTestVisible="False"
                            Text="{Binding Placeholder, ElementName=Root}"
                            Visibility="Collapsed" />

                    </Grid>
                </Border>

                <!--  RECHTE SPALTE  -->
                <Button
                    Grid.Column="2"
                    Click="ClearButton_Click"
                    Style="{StaticResource ClearButtonStyle}"
                    ToolTip="Text löschen" />

            </Grid>
        </Border>

        <!--  AUTOCOMPLETE POPUP  -->
        <Popup
            x:Name="SuggestionPopup"
            AllowsTransparency="True"
            Focusable="False"
            Placement="Bottom"
            PlacementTarget="{Binding ElementName=Root}"
            PopupAnimation="None"
            StaysOpen="True">

            <Border
                x:Name="PopupBorder"
                Padding="3"
                Background="White"
                BorderBrush="#D5D5D5"
                BorderThickness="1"
                CornerRadius="7">

                <ListBox
                    x:Name="SuggestionList"
                    MaxHeight="{Binding SuggestionMaxHeight, ElementName=Root}"
                    Background="Transparent"
                    BorderThickness="0"
                    ItemContainerStyle="{StaticResource SuggestionItemStyle}"
                    ItemTemplate="{StaticResource SuggestionTemplate}"
                    PreviewMouseLeftButtonDown="SuggestionList_MouseDown"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" />

            </Border>
        </Popup>

    </Grid>
</UserControl>
