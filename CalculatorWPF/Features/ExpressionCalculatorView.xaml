<UserControl
    x:Class="System.Windows.Calculator.ExpressionCalculatorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Calculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="400"
    mc:Ignorable="d">
    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Ergebnis  -->
        <TextBox
            Grid.Row="0"
            HorizontalContentAlignment="Right"
            FontSize="28"
            IsReadOnly="True"
            Text="{Binding Path=DisplayText}" />

        <!--  Eingabe  -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,10"
            ColumnDefinitions="Auto,Auto,*"
            RowDefinitions="Auto">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Memory:" />

            <TextBox
                Grid.Column="1"
                Width="40"
                Margin="8,0"
                Text="{Binding Path=MemoryValue, UpdateSourceTrigger=PropertyChanged}" />

            <TextBox
                x:Name="ExpressionBox"
                Grid.Column="2"
                Width="Auto"
                HorizontalContentAlignment="Stretch"
                FontSize="20"
                KeyDown="ExpressionBox_KeyDown"
                PreviewKeyDown="ExpressionBox_PreviewKeyDown"
                Text="{Binding Path=ExpressionText, UpdateSourceTrigger=PropertyChanged}" />
        </Grid>

        <!--  Fehler  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,5,0,0"
            Foreground="Red"
            Text="{Binding Path=ErrorText}" />

    </Grid>
</UserControl>
