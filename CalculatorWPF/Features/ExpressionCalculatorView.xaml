    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Ergebnis  -->
        <TextBox
            Grid.Row="0"
            HorizontalContentAlignment="Right"
            VerticalContentAlignment="Center"
            FontSize="28"
            IsReadOnly="True"
            Text="{Binding Path=DisplayText, FallbackValue=~0}" />

        <!--  Eingabe  -->
        <Grid
            Grid.Row="2"
            Margin="0,0,0,10"
            ColumnDefinitions="Auto,Auto,*"
            RowDefinitions="Auto,Auto">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Text="Memory:" />

            <TextBox
                Grid.Column="1"
                Width="40"
                Margin="8,0"
                VerticalContentAlignment="Center"
                Text="{Binding Path=MemoryValue, UpdateSourceTrigger=PropertyChanged, FallbackValue=~0}" />

            <UI:WindowAutoCompleteTextBox
                x:Name="ExpressionBox"
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,5,0,0"
                ENTERCommand="{Binding Path=FuncENTERCommand}"
                F2Command="{Binding Path=OpenFuncDialogF2Command}"
                F2CommandParameter="{Binding Path=Text, RelativeSource={RelativeSource Self}}"
                HighlightBrush="#CDE4FF"
                Icon="{StaticResource IconDatabase_Calc}"
                ObservableSuggestions="{Binding Path=SearchSuggestions}"
                Placeholder="Funktion auswählen ..."
                SuggestionMaxHeight="200"
                Text="{Binding Path=ExpressionText, UpdateSourceTrigger=PropertyChanged, FallbackValue=~0}" />
        </Grid>

        <!--  Fehler  -->
        <TextBlock
            Grid.Row="3"
            Margin="0,5,0,0"
            Foreground="Red"
            Text="{Binding Path=ErrorText}" />

    </Grid>
</base:UserControlBase>
