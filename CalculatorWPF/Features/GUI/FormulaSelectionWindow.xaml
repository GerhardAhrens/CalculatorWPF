<base:WindowBase
    x:Class="System.Windows.Calculator.FormulaSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Calculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Formel auswählen"
    Width="600"
    Height="450"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="10">

        <ListView
            x:Name="lvItems"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="lvItems_MouseDoubleClick"
            SelectedItem="{Binding SelectedItem}">
            <ListView.Resources>
                <Style x:Key="TbStyle" TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="None" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Setter Property="FontFamily" Value="Segue UI Light" />
                    <Setter Property="FontSize" Value="13" />
                </Style>

                <Style x:Key="TextHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Left" />
                </Style>

                <Style x:Key="NumericHeaderStyle" TargetType="{x:Type GridViewColumnHeader}">
                    <Setter Property="HorizontalContentAlignment" Value="Right" />
                </Style>
            </ListView.Resources>

            <ListView.View>

                <GridView>

                    <GridViewColumn
                        Width="80"
                        DisplayMemberBinding="{Binding Path=Category}"
                        Header="Typ"
                        HeaderContainerStyle="{StaticResource ResourceKey=TextHeaderStyle}" />

                    <GridViewColumn
                        Width="120"
                        Header="Name"
                        HeaderContainerStyle="{StaticResource ResourceKey=TextHeaderStyle}">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock
                                    Style="{StaticResource ResourceKey=TbStyle}"
                                    Text="{Binding Path=Name}"
                                    ToolTip="{Binding Path=Description}" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn
                        Width="300"
                        DisplayMemberBinding="{Binding Path=Signature}"
                        Header="Parameter"
                        HeaderContainerStyle="{StaticResource ResourceKey=TextHeaderStyle}" />

                    <GridViewColumn
                        Width="1000"
                        DisplayMemberBinding="{Binding Path=Example}"
                        Header="Beispiel"
                        HeaderContainerStyle="{StaticResource ResourceKey=TextHeaderStyle}" />

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>
</base:WindowBase>
