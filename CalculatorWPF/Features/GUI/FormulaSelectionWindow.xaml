<base:WindowBase
    x:Class="System.Windows.Calculator.FormulaSelectionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:System.Windows"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:System.Windows.Calculator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Formel auswählen"
    Width="600"
    Height="450"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid Margin="10">

        <ListView
            x:Name="lvItems"
            ItemsSource="{Binding Items}"
            MouseDoubleClick="lvItems_MouseDoubleClick"
            SelectedItem="{Binding SelectedItem}">

            <ListView.View>

                <GridView>

                    <GridViewColumn
                        Width="90"
                        DisplayMemberBinding="{Binding Category}"
                        Header="Typ" />

                    <GridViewColumn
                        Width="140"
                        DisplayMemberBinding="{Binding Name}"
                        Header="Name" />

                    <GridViewColumn
                        Width="300"
                        DisplayMemberBinding="{Binding Signature}"
                        Header="Parameter" />

                </GridView>

            </ListView.View>

        </ListView>

    </Grid>
</base:WindowBase>
