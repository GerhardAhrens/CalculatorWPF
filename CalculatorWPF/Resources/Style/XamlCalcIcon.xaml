<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="CalculatorIconBrush" Color="Black" />

    <Pen
        x:Key="IconPen"
        Brush="{DynamicResource CalculatorIconBrush}"
        EndLineCap="Round"
        LineJoin="Round"
        StartLineCap="Round"
        Thickness="1.5" />

    <!--#region Zeile 0 Memory Funktionen-->
    <DrawingImage x:Key="Calculator.MemoryClear">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  M  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="2.5,11.5" EndPoint="2.5,4.5" />
                            <LineGeometry StartPoint="2.5,4.5" EndPoint="5.0,8.0" />
                            <LineGeometry StartPoint="5.0,8.0" EndPoint="7.5,4.5" />
                            <LineGeometry StartPoint="7.5,4.5" EndPoint="7.5,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  C  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="M 13.2,5.0 A 3.0,3.0 0 1 0 13.2,11.0" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  MR  -->
    <DrawingImage x:Key="Calculator.MemoryRecall">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  M  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="2.2,11.5" EndPoint="2.2,4.5" />
                            <LineGeometry StartPoint="2.2,4.5" EndPoint="4.7,8.0" />
                            <LineGeometry StartPoint="4.7,8.0" EndPoint="7.2,4.5" />
                            <LineGeometry StartPoint="7.2,4.5" EndPoint="7.2,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  R  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="9.5,4.5" EndPoint="9.5,11.5" />
                            <PathGeometry Figures="M 9.5,4.5 H 11.7 A 1.3,1.3 0 0 1 11.7,7.1 H 9.5" />
                            <LineGeometry StartPoint="10.3,7.1" EndPoint="12.3,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  MS  -->
    <DrawingImage x:Key="Calculator.MemoryStore">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  M  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="2.2,11.5" EndPoint="2.2,4.5" />
                            <LineGeometry StartPoint="2.2,4.5" EndPoint="4.7,8.0" />
                            <LineGeometry StartPoint="4.7,8.0" EndPoint="7.2,4.5" />
                            <LineGeometry StartPoint="7.2,4.5" EndPoint="7.2,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  S  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures=" M 12.2,5.0 C 11.4,4.5 10.0,4.5 9.7,5.7 C 9.4,6.8 12.1,6.8 12.2,8.2 C 12.3,9.7 10.6,10.0 9.6,9.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  M+  -->
    <DrawingImage x:Key="Calculator.MemoryAdd">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  M  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="2.2,11.5" EndPoint="2.2,4.5" />
                            <LineGeometry StartPoint="2.2,4.5" EndPoint="4.7,8.0" />
                            <LineGeometry StartPoint="4.7,8.0" EndPoint="7.2,4.5" />
                            <LineGeometry StartPoint="7.2,4.5" EndPoint="7.2,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  +  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="11,5.5" EndPoint="11,10.5" />
                            <LineGeometry StartPoint="8.5,8" EndPoint="13.5,8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  M−  -->
    <DrawingImage x:Key="Calculator.MemorySubtract">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <!--  M  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="2.2,11.5" EndPoint="2.2,4.5" />
                            <LineGeometry StartPoint="2.2,4.5" EndPoint="4.7,8.0" />
                            <LineGeometry StartPoint="4.7,8.0" EndPoint="7.2,4.5" />
                            <LineGeometry StartPoint="7.2,4.5" EndPoint="7.2,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <!--  −  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="8.5,8" EndPoint="13.5,8" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <!--#endregion Zeile 0 Memory Funktionen-->

    <!--  Prozent  -->
    <DrawingImage x:Key="Calculator.Percent">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <EllipseGeometry
                            Center="5,5"
                            RadiusX="1.2"
                            RadiusY="1.2" />
                        <EllipseGeometry
                            Center="11,11"
                            RadiusX="1.2"
                            RadiusY="1.2" />
                        <LineGeometry StartPoint="5.8,10.2" EndPoint="10.2,5.8" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  C  -->
    <DrawingImage x:Key="Calculator.Clear">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                <GeometryDrawing.Geometry>
                    <!--  Offenes C  -->
                    <PathGeometry Figures="                     M 10.8,4.5                     A 4.2,4.2 0 1 0 10.8,11.5" />
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  CE  -->
    <DrawingImage x:Key="Calculator.ClearEntry">
        <DrawingImage.Drawing>
            <DrawingGroup>

                <!--  C  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <PathGeometry Figures="                         M 7.2,4.5                         A 3.2,3.2 0 1 0 7.2,11.5" />
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

                <!--  E  -->
                <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <LineGeometry StartPoint="9.5,4.5" EndPoint="12.5,4.5" />
                            <LineGeometry StartPoint="9.5,8.0" EndPoint="12.0,8.0" />
                            <LineGeometry StartPoint="9.5,11.5" EndPoint="12.5,11.5" />
                            <LineGeometry StartPoint="9.5,4.5" EndPoint="9.5,11.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>

            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Division  -->
    <DrawingImage x:Key="Calculator.Divide">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <EllipseGeometry
                            Center="8,4.5"
                            RadiusX="0.9"
                            RadiusY="0.9" />
                        <LineGeometry StartPoint="4.5,8" EndPoint="11.5,8" />
                        <EllipseGeometry
                            Center="8,11.5"
                            RadiusX="0.9"
                            RadiusY="0.9" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!--  Backspace  -->
    <DrawingImage x:Key="Calculator.Backspace">
        <DrawingImage.Drawing>
            <GeometryDrawing Brush="{x:Null}" Pen="{StaticResource IconPen}">
                <GeometryDrawing.Geometry>
                    <GeometryGroup>
                        <!--  Pfeilspitze  -->
                        <LineGeometry StartPoint="5,8" EndPoint="8,5" />
                        <LineGeometry StartPoint="5,8" EndPoint="8,11" />
                        <!--  Schaft  -->
                        <LineGeometry StartPoint="5,8" EndPoint="12.5,8" />
                    </GeometryGroup>
                </GeometryDrawing.Geometry>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

</ResourceDictionary>